# Copiez ce fichier en ".env" et remplacez TOUTES les valeurs. Ne le versionnez jamais.
# Générer un secret :  openssl rand -hex 48

APP_URL="https://votre-domaine.ml"

POSTGRES_USER="medisahel_user"
POSTGRES_DB="medisahel_db"
POSTGRES_PASSWORD="CHANGEZ_MOI"

# Hors Docker (PM2/local), URL complète :
# DATABASE_URL="postgresql://medisahel_user:MOT_DE_PASSE@localhost:5432/medisahel_db?schema=public"

# 64+ caractères aléatoires. Le serveur REFUSE de démarrer en production sans lui.
JWT_SECRET="CHANGEZ_MOI"

# Premier administrateur, créé au premier démarrage si la base est vide
ADMIN_EMAIL="admin@votre-domaine.ml"
ADMIN_PASSWORD="CHANGEZ_MOI_12_CARACTERES_MINIMUM"
ADMIN_NAME="Administrateur"
CLINIC_NAME="Ma Clinique"

# Origines autorisées pour CORS, séparées par des virgules (par défaut : APP_URL)
# CORS_ORIGINS="https://votre-domaine.ml"

# Développement uniquement (ignoré en production) : recrée les comptes de démonstration
# ALLOW_DEMO_ACCOUNTS="true"

# GEMINI_API_KEY="..."
